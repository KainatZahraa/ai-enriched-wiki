      "id": "c06c030f-87ac-45d8-89e2-d16aee3ec864",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "jsCode": "// Get the triggered page (from the IF node, via Notion Trigger)\nconst triggeredPage = $('If').item.json;\n\n// Get all pages (from Get many database pages)\nconst allPages = $input.all();\n\n// Build list of other topic titles, excluding current page\nconst otherTitles = allPages\n  .map(item => item.json.property_name)\n  .filter(title => title && title !== triggeredPage.Name);\n\nconst prompt = `You are helping build an internal engineering wiki. Below is a page written by an intern documenting something they learned.\n\nGenerate the following, based ONLY on the content provided:\n\n1. TLDR: 2-3 sentence summary\n2. FAQs: 3-5 likely questions with concise answers\n3. Quiz: 3-5 questions to test retention, with answers\n4. Related Topics: from this list of existing topics: ${JSON.stringify(otherTitles)}, pick any that are meaningfully related. Return empty list if none are.\n5. Suggested Next Learning: 2-3 topics a learner should study next\n\nReturn ONLY valid JSON, no other text, in this structure:\n{\n  \"tldr\": \"\",\n  \"faqs\": [{\"q\": \"\", \"a\": \"\"}],\n  \"quiz\": [{\"question\": \"\", \"answer\": \"\"}],\n  \"related_topics\": [],\n  \"next_learning\": []\n}\n\nPAGE CONTENT:\n${triggeredPage.Content}`;\n\nreturn [{ json: { prompt, pageId: triggeredPage.id, pageName: triggeredPage.Name } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        0
      ],
      "id": "21c5637e-3c30-45d9-a553-46cbe3238453",
      "name": "Build Prompt"
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\n\nlet rawText = response.candidates[0].content.parts[0].text;\nrawText = rawText.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\nlet success = true;\n\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  success = false;\n  parsed = null;\n}\n\n// Build human-readable formatted text versions\nlet faqsFormatted = '';\nlet quizFormatted = '';\nlet relatedFormatted = '';\nlet nextLearningFormatted = '';\n\nif (success && parsed) {\n  faqsFormatted = parsed.faqs\n    .map(item => `Q: ${item.q}\\nA: ${item.a}`)\n    .join('\\n\\n');\n\n  quizFormatted = parsed.quiz\n    .map((item, i) => `${i + 1}. ${item.question}\\nAnswer: ${item.answer}`)\n    .join('\\n\\n');\n\n  relatedFormatted = parsed.related_topics.length > 0\n    ? parsed.related_topics.join(', ')\n    : 'None yet';\n\n  nextLearningFormatted = parsed.next_learning\n    .map(item => `• ${item}`)\n    .join('\\n');\n}\n\nreturn [{\n  json: {\n    success,\n    parsed,\n    faqsFormatted,\n    quizFormatted,\n    relatedFormatted,\n    nextLearningFormatted,\n    pageId: $('Build Prompt').item.json.pageId,\n    pageName: $('Build Prompt').item.json.pageName\n  }\n}];"
      },
